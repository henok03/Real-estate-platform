# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Database URL
# Format: postgres://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgres://neondb_owner:npg_samplepassword@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication Secret
JWT_SECRET="aura_realestate_production_jwt_secret_key_1234567890"

# Initial admin credential for first run if database has no admin users:
# Email: admin@auraestates.com
# Password: AdminPassword123!
